---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import TagFilter from '../../components/TagFilter.astro'
import CountLine from '../../components/CountLine.astro'
import RequestPath from '../../components/RequestPath.astro'

// Featured first, then by the explicit order field. Featured entries render at
// full width, the rest render two up, so the listing is composed rather than
// repeated and reads as finished with one entry and correct with five.
const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1
  return a.data.order - b.data.order
})

const featured = projects.filter((entry) => entry.data.featured)
const rest = projects.filter((entry) => !entry.data.featured)

const tags = [...new Set(projects.flatMap((entry) => entry.data.tags))].sort()

const LEDE =
  'Case studies on the layers underneath LLM products: the streaming edge, the orchestration tier, the agent pipeline, and the conversation state they share. Described in general terms throughout.'
---

<Layout title="Case studies, Tushar Chauhan" description={LEDE} activeNav="work">
  <section class="page-head">
    <div class="shell">
      <div class="grid12">
        <div class="page-head-block reveal">
          <p class="micro page-kicker">CASE STUDIES</p>
          <h1>Case studies</h1>
          <p class="lede">{LEDE}</p>
        </div>
      </div>
    </div>
  </section>

  <!--
    The second unit on this page, and it does not depend on how many entries the
    collection holds. The lede above names four layers; this is the shape a staged
    request takes across them, drawn by the component the case study itself uses,
    with its own titlebar saying it carries no timing data. Nothing here is
    authored copy: the panel owns every string in it.
  -->
  <section class="work-path" aria-labelledby="work-path-heading">
    <div class="shell">
      <h2 class="label work-path-h2" id="work-path-heading">THE REQUEST PATH, SCHEMATICALLY</h2>
      <RequestPath class="reveal" />
    </div>
  </section>

  <section class="work-list" aria-labelledby="work-list-heading">
    <div class="shell">
      <!--
        A ruled toolbar rather than a floating control strip: the label names the
        region for assistive technology and the filter sits on the same rule.
      -->
      <div class="work-bar reveal">
        <h2 class="label" id="work-list-heading">ALL CASE STUDIES</h2>
        <TagFilter tags={tags} />
      </div>

      {
        featured.length > 0 && (
          <div class="work-featured">
            {featured.map((entry, index) => (
              <div class="reveal" style={`--i: ${index}`}>
                <ProjectCard
                  slug={entry.id}
                  title={entry.data.title}
                  summary={entry.data.summary}
                  role={entry.data.role}
                  timeframe={entry.data.timeframe}
                  stack={entry.data.stack}
                  tags={entry.data.tags}
                  featured
                  demo={entry.data.links.demo}
                />
              </div>
            ))}
          </div>
        )
      }

      {
        rest.length > 0 && (
          <div class="card-grid work-rest">
            {rest.map((entry, index) => (
              <div class="reveal work-cell" style={`--i: ${index}`}>
                <ProjectCard
                  slug={entry.id}
                  title={entry.data.title}
                  summary={entry.data.summary}
                  role={entry.data.role}
                  timeframe={entry.data.timeframe}
                  stack={entry.data.stack}
                  tags={entry.data.tags}
                  demo={entry.data.links.demo}
                />
              </div>
            ))}
          </div>
        )
      }

      <CountLine count={projects.length} singular="case study" plural="case studies" />
    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2.25rem, 4vw, 3rem);
  }

  .page-head-block {
    grid-column: 1 / -1;
  }

  @media (min-width: 70rem) {
    .page-head-block {
      grid-column: 1 / 9;
    }
  }

  .page-kicker {
    margin: 0 0 1rem;
  }

  .page-head-block h1 {
    margin: 0;
  }

  .page-head-block .lede {
    margin: 1.5rem 0 0;
  }

  .work-path {
    padding-block: 0 clamp(2.5rem, 5vw, 4rem);
  }

  .work-path-h2 {
    margin: 0 0 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-edge);
  }

  .work-list {
    padding-block: 0 clamp(4rem, 7vw, 6.5rem);
  }

  .work-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-edge);
    border-bottom: 1px solid var(--color-edge);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .work-bar h2 {
    margin: 0;
  }

  .work-featured {
    display: grid;
    gap: 2rem;
  }

  .work-featured + .work-rest {
    margin-top: 2rem;
  }

  /* The wrapper carries the reveal stagger, so the card itself still fills the
     grid cell to a shared height. */
  .work-cell {
    display: flex;
  }

  .work-cell > :global(.project-card) {
    width: 100%;
  }
</style>
