---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Plate from '../../components/Plate.astro'
import KeyValue from '../../components/KeyValue.astro'
import Pill from '../../components/Pill.astro'
import Button from '../../components/Button.astro'
import Prose from '../../components/Prose.astro'
import PullQuote from '../../components/PullQuote.astro'
import { page } from '../../lib/url'
import RequestPath from '../../components/RequestPath.astro'
import { REQUEST_PATH_SLUGS } from '../../lib/spans'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  // The slug is entry.id. entry.slug does not exist in Astro 5 and above.
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
// `headings` is what Astro's renderer already produced from the rendered body,
// slugs included, so the rail's jump links point at ids that exist. Nothing here
// parses HTML.
const { Content, headings } = await render(entry)
const { title, summary, role, timeframe, stack, tags, links } = entry.data

// Only the demo link is ever read. links.repo exists in the schema and is
// deliberately never rendered: nothing on this site links to a code host.
const demo = links.demo

const meta = [
  { key: 'ROLE', value: role },
  { key: 'TIMEFRAME', value: timeframe },
  { key: 'STACK', value: stack.join(', ') },
]

const showRequestPath = REQUEST_PATH_SLUGS.has(entry.id)

const body = entry.body ?? ''
const words = body.trim().split(/\s+/).filter(Boolean).length
const minutes = Math.max(1, Math.round(words / 220))

const railMeta = [
  { key: 'TIMEFRAME', value: timeframe },
  { key: 'READ', value: `${minutes} MIN` },
  { key: 'WORDS', value: String(words) },
]

/*
  THE PULL QUOTE, TAKEN VERBATIM FROM THE BODY.

  No sentence on this page is written by the template. The band re-sets one
  sentence the case study itself contains, at the h2 step, and its caption links
  back to the section that sentence came from, so the device is a quotation and a
  jump link at once.

  The selection is mechanical, so a future case study gets a band without anybody
  hand picking a line: strip fenced code and inline Markdown, walk the sections
  under each h2, and keep the SHORTEST complete sentence between 60 and 130
  characters that carries no quotation mark of its own. Shortest, because a pull
  quote has to survive being set at 52px. No nested quotation marks, because a
  quote inside a quote reads as a typesetting fault.

  If nothing qualifies, no band is rendered and the page is complete without it.
  This lives in the page rather than in Prose because a full bleed band has to be
  a direct child of the article, outside .shell.
*/
type Pull = { quote: string; source: string; slug: string }

const h2s = headings.filter((h) => h.depth === 2)

const pickPull = (): Pull | null => {
  const sections = body.replace(/```[\s\S]*?```/g, '\n').split(/^##\s+.*$/m).slice(1)
  let best: Pull | null = null
  for (let i = 0; i < sections.length; i += 1) {
    const heading = h2s[i]
    if (!heading) continue
    const clean = sections[i]
      .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
      .replace(/[*_`]/g, '')
      .replace(/\s+/g, ' ')
    for (const raw of clean.split(/(?<=\.)\s+/)) {
      const s = raw.trim()
      if (s.length < 60 || s.length > 130) continue
      if (!s.endsWith('.') || /["“”]/.test(s)) continue
      if (best && best.quote.length <= s.length) continue
      best = { quote: s, source: heading.text, slug: heading.slug }
    }
  }
  return best
}

const band = pickPull()
---

<Layout title={`${title}, Tushar Chauhan`} description={summary} ogType="article" activeNav="work">
  <article class="case">
    <section class="case-head">
      <div class="shell">
        <p class="micro case-crumb">
          <a href={page('/projects')}>CASE STUDIES</a> <span aria-hidden="true">/</span> {timeframe}
        </p>
        <!--
          The title spans the whole shell. It used to be capped at 24ch inside ten
          columns, which stacked it into three lines with the right third of the
          screen empty beside it.
        -->
        <div class="case-title-block reveal">
          <h1>{title}</h1>
          <div class="grid12 case-standfirst">
            <p class="lede case-lede">{summary}</p>
          </div>
        </div>
      </div>
    </section>

    <div class="shell case-plate">
      <Plate
        slug={entry.id}
        variant="banner"
        caption={`PLATE, DETERMINISTIC FROM ${entry.id.toUpperCase()}`}
      />
    </div>

    <!--
      The meta readout. Rules rather than a filled card, which is the system
      everywhere outside the rounded panels. With no demo link the right hand
      cell simply holds the tag pills, which is a complete composition rather
      than a gap where a button used to be.
    -->
    <div class="case-meta">
      <div class="shell">
        <div class="case-meta-grid">
          <KeyValue rows={meta} keyWidth="7rem" />
          <div class="case-tags">
            <p class="micro case-tags-key">TAGS</p>
            <ul class="pill-row">
              {tags.map((tag) => <Pill label={tag} as="li" />)}
            </ul>
            {
              demo && (
                <p class="case-demo">
                  <Button href={demo} label="Live demo" variant="secondary" />
                </p>
              )
            }
          </div>
        </div>
      </div>
    </div>

    <div class="shell case-body">
      <Prose headings={headings} meta={railMeta} railLabel="Case study readout">
        <Content />
      </Prose>
    </div>

    {band && <PullQuote quote={band.quote} source={band.source} href={`#${band.slug}`} />}

    {
      showRequestPath && (
        <section class="case-path" aria-labelledby="path-heading">
          <div class="shell">
            <h2 class="label" id="path-heading">
              THE REQUEST PATH, SCHEMATICALLY
            </h2>
            <RequestPath class="reveal" />
          </div>
        </section>
      )
    }

    <div class="case-foot">
      <div class="shell">
        <div class="case-foot-row">
          <Button href={page('/projects')} label="All case studies" variant="secondary" />
          <a class="micro case-foot-link" href={page('/blog')}>Notes</a>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .case-head {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
  }

  .case-crumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  /* Full shell width, and text-wrap: balance rather than a character cap, so the
     lines break where the title reads best instead of where 24ch happens to fall. */
  .case-title-block h1 {
    margin: 0;
    max-width: none;
    text-wrap: balance;
  }

  .case-standfirst {
    margin-top: 1.5rem;
  }

  /* The summary sits over the measure, so the two columns of the body below are
     already established before the body starts. */
  .case-lede {
    grid-column: 1 / -1;
    margin: 0;
  }

  @media (min-width: 70rem) {
    .case-lede {
      grid-column: 1 / 8;
    }
  }

  .case-plate {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .case-meta {
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
  }

  .case-meta-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--color-edge);
    border-bottom: 1px solid var(--color-edge);
  }

  @media (min-width: 56.25rem) {
    .case-meta-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 2.5rem;
      align-items: start;
    }
  }

  .case-tags-key {
    margin: 0 0 0.75rem;
  }

  .case-demo {
    margin: 1.25rem 0 0;
  }

  .case-body {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem);
  }

  /* The body's own two column geometry, the measure and the readout rail, now
     comes from Prose.astro, so there is nothing left to place here. */

  .case-path {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-edge);
  }

  /* The quote band already closes itself with a rule on both edges, so whatever
     follows it drops its own rather than draw two hairlines 1px apart. */
  :global(.quote-band) + .case-path,
  :global(.quote-band) + .case-foot {
    border-top: 0;
  }

  .case-path h2 {
    margin: 0 0 1.5rem;
  }

  .case-foot {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--color-edge);
  }

  .case-foot-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .case-foot-link {
    color: var(--color-muted);
  }

  .case-foot-link:hover,
  .case-foot-link:focus-visible {
    color: var(--color-text);
  }
</style>
