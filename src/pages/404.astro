---
import Layout from '../layouts/Layout.astro'
import KeyValue, { type KeyValueRow } from '../components/KeyValue.astro'
import Plate from '../components/Plate.astro'

const routes: KeyValueRow[] = [
  { key: 'HOME', value: '/', href: '/' },
  { key: 'CASE STUDIES', value: '/projects', href: '/projects' },
  { key: 'NOTES', value: '/blog', href: '/blog' },
  { key: 'RESUME', value: '/resume', href: '/resume' },
]
---

<Layout
  title="Page not found, Tushar Chauhan"
  description="That page does not exist. Here are the pages that do."
  activeNav="none"
>
  <section class="nf">
    <div class="shell nf-body">
      <div class="nf-col">
        <p class="label nf-code">404</p>
        <h1>That page is not here.</h1>
        <p class="lede nf-lede">The page you asked for does not exist. These do.</p>
        <!-- The wrapper carries the scoped rules. A class passed to a component
             lands on that component's root element but not this page's style
             scope, so styling it from here needs an element this page owns. -->
        <div class="nf-kv">
          <KeyValue rows={routes} keyWidth="9rem" />
        </div>
      </div>
    </div>
    <!--
      Decorative, and deliberately not wrapped in .shell so it runs to the viewport
      edge and is clipped by the section. Dimmed to 40 percent so it reads as
      housing rather than as content. No aria-hidden here: a plate passed no
      caption carries aria-hidden on its own figure, so repeating it on this
      wrapper would hide the same subtree twice. The wrapper stays because it owns
      the opacity, the pointer-events and the height override.
    -->
    <div class="nf-plate">
      <Plate slug="404" variant="banner" />
    </div>
  </section>
</Layout>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    min-height: 92svh;
    overflow: clip;
    padding-block: clamp(3rem, 8vh, 6rem) 0;
  }
  /* auto margins centre the copy in whatever space the plate band leaves. */
  .nf-body {
    margin-block: auto;
  }
  .nf-col {
    max-width: 40rem;
  }
  .nf-code {
    margin: 0 0 1.25rem;
  }
  .nf h1 {
    margin: 0;
    max-width: 18ch;
  }
  .nf-lede {
    margin: 1.5rem 0 0;
  }
  .nf-kv {
    margin-top: 2.5rem;
    max-width: 26rem;
    border-top: 1px solid var(--color-edge);
  }
  /* At its own 16 by 7 ratio a banner plate is 630px tall on a 1440px screen,
     which on this page would push the copy off the fold and read as a broken
     table. width: 100% from .plate plus an explicit height makes both axes
     definite, so aspect-ratio is ignored and preserveAspectRatio="xMidYMid slice"
     crops the field to a centred foot band rather than squashing it: the grid,
     the lane rules, the comb and the intervals all keep their true proportions. */
  .nf-plate {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    opacity: 0.4;
    pointer-events: none;
  }
  .nf-plate :global(.plate) {
    aspect-ratio: auto !important;
    height: clamp(110px, 16vh, 180px);
  }
</style>
