---
import Layout from '../layouts/Layout.astro'
import KeyValue, { type KeyValueRow } from '../components/KeyValue.astro'
import { page } from '../lib/url'

const routes: KeyValueRow[] = [
  { key: 'HOME', value: '/', href: page('/') },
  { key: 'NOTES', value: '/blog', href: page('/blog') },
  { key: 'RESUME', value: '/resume', href: page('/resume') },
]
---

<Layout
  title="Page not found, Tushar Chauhan"
  description="That page does not exist. Here are the pages that do."
  activeNav="none"
>
  <section class="nf">
    <div class="shell nf-body">
      <div class="nf-col">
        <p class="label nf-code">404</p>
        <h1>That page is not here.</h1>
        <p class="lede nf-lede">The page you asked for does not exist. These do.</p>
        <!-- The wrapper carries the scoped rules. A class passed to a component
             lands on that component's root element but not this page's style
             scope, so styling it from here needs an element this page owns. -->
        <div class="nf-kv">
          <KeyValue rows={routes} keyWidth="9rem" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    min-height: 92svh;
    overflow: clip;
    padding-block: clamp(3rem, 8vh, 6rem) 0;
  }
  /* auto margins centre the copy in whatever space the plate band leaves. */
  .nf-body {
    margin-block: auto;
  }
  .nf-col {
    max-width: 40rem;
  }
  .nf-code {
    margin: 0 0 1.25rem;
  }
  .nf h1 {
    margin: 0;
    max-width: 18ch;
  }
  .nf-lede {
    margin: 1.5rem 0 0;
  }
  .nf-kv {
    margin-top: 2.5rem;
    max-width: 26rem;
    border-top: 1px solid var(--color-edge);
  }
</style>
