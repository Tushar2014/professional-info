---
import BaseHead from '../components/BaseHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'

interface Props {
  title: string
  description: string
  ogType?: 'website' | 'article'
  activeNav?: 'work' | 'writing' | 'resume' | 'none'
}

const { title, description, ogType, activeNav = 'none' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogType={ogType} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader activeNav={activeNav} />
    <!--
      Layout deliberately does not wrap content in .shell. Sections do that
      themselves, because a section has to be able to bleed to the viewport edge.
    -->
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <script>
      import '../scripts/motion.ts'
    </script>
  </body>
</html>
