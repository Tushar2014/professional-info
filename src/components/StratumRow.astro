---
interface Props {
  index: string
  title: string
  copy: string
  note: string
}

const { index, title, copy, note } = Astro.props

/*
  One stratum of the stack. Square, ruled, no fill: the rows are separated by
  hairlines and by the rail node, never by a card. The rail itself is painted by
  the consuming list in index.astro, which also supplies --rail-inset.

  DISCLOSURE. This row carried a third column of technology pills, one set per
  stratum, under a heading reading "The layers I work in". Naming a tier and then
  listing named technologies beside it reads as a description of an employer's
  internal architecture, and nothing in profile.ts supports any such assignment:
  profile.skills is a flat grouped inventory with no tier in it. The pills are
  gone and the prop is gone with them, so the row cannot be handed a tier to
  technology mapping again. The named technologies still appear once on the page,
  in #stack, grouped exactly as profile.ts groups them and attached to no tier
  and no employer.

  The mono note takes the third column instead. It is the same copy the row
  already carried, it is drawn from his own published post and case study, and it
  names no system, so the column now holds real content rather than a claim.
*/
---

<li class="stratum-row">
  <p class="figure-sm stratum-index" aria-hidden="true">{index}</p>
  <div class="stratum-main">
    <h3>{title}</h3>
    <p class="stratum-copy">{copy}</p>
  </div>
  <p class="micro stratum-note">{note}</p>
</li>

<style>
  .stratum-row {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 1rem;
    padding-block: 3rem;
    border-bottom: 1px solid var(--color-edge);
    border-radius: 0;
  }

  /* The node on the rail. 7px, steel, never accent. */
  .stratum-row::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--rail-inset, 1.5rem) - 3px);
    top: 3.35rem;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-steel);
  }

  .stratum-index {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    color: var(--color-muted);
    line-height: var(--text-h3--line-height);
  }

  .stratum-main {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .stratum-main h3 {
    margin: 0;
  }

  .stratum-copy {
    margin: 0.875rem 0 0;
    max-width: 62ch;
    color: var(--color-muted);
  }

  /* Below 1120px the note sits under the copy, introduced by a 24px hairline. */
  .stratum-note {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    grid-column: 2;
    grid-row: 2;
    margin: 0;
    color: var(--color-steel);
  }

  .stratum-note::before {
    content: '';
    flex: none;
    width: 24px;
    height: 1px;
    background: var(--color-edge);
  }

  @media (min-width: 56.25rem) {
    .stratum-row {
      grid-template-columns: 56px minmax(0, 1fr);
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 70rem) {
    .stratum-row {
      grid-template-columns: 64px minmax(0, 1fr) 320px;
      column-gap: 2.5rem;
    }
    /* In its own column the note gets a rule over the full track instead of a
       24px lead in, so the third column reads as a labelled readout rather than
       as a leftover margin. */
    .stratum-note {
      display: block;
      grid-column: 3;
      grid-row: 1;
      margin-top: 0.4rem;
      padding-top: 0.9rem;
      border-top: 1px solid var(--color-edge);
      line-height: 1.7;
    }
    .stratum-note::before {
      content: none;
    }
  }
</style>
