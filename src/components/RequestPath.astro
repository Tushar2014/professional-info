---
import Panel from './Panel.astro'
import KeyValue from './KeyValue.astro'
import { REQUEST_SPANS, spanGeometry } from '../lib/spans'

interface Props {
  title?: string
  footnote?: string
  class?: string
}

const {
  title = 'SCHEMATIC REQUEST PATH',
  footnote = 'The shape of a staged request through the layers described above. Proportions are schematic and carry no timing data.',
  class: className = '',
} = Astro.props

// The geometry is computed here, on the server, so the chart is complete and
// correct with JavaScript disabled. There are no millisecond figures, no HTTP
// status and no telemetry in this component: it is a shape, and the titlebar
// says so.
const rows = REQUEST_SPANS.map((span) => ({ span, geometry: spanGeometry(span) }))

const GRIDLINES = [20, 40, 60, 80]
const COUNTS = [
  { key: 'STAGES', value: String(REQUEST_SPANS.length) },
  { key: 'CONCURRENT PAIR', value: '1' },
  { key: 'CANCELLATION PATH', value: '1' },
]
---

<div class={className}>
  <Panel tone="surface" corner="panel" pad="none">
    <div class="rp-titlebar">
      <h3 class="label">{title}</h3>
      <p class="micro">ILLUSTRATIVE SHAPE, NOT PRODUCTION DATA</p>
    </div>

    <div class="rp-axis">
      <p class="micro">REQUEST IN</p>
      <p class="micro">RESPONSE COMPLETE</p>
    </div>

    <div class="rp-body">
      <div class="rp-grid" aria-hidden="true">
        {GRIDLINES.map((at) => <i style={`left: ${at}%`}></i>)}
      </div>

      {
        rows.map(({ span, geometry }) => (
          <>
            <div class:list={['rp-row', span.authored && 'rp-authored']}>
              <p class="label">{span.label}</p>
              <div class="rp-track">
                <div
                  class="rp-bar"
                  data-span={span.id}
                  data-authored={span.authored ? 'true' : 'false'}
                  data-weight={span.weight}
                  style={`left: ${geometry.left}; width: ${geometry.width}`}
                />
                {geometry.tailLeft && (
                  <span
                    class="span-tail"
                    aria-hidden="true"
                    style={`left: ${geometry.tailLeft}; width: ${geometry.tailWidth}`}
                  />
                )}
              </div>
            </div>
            {span.id === 'intent' && (
              <p class="micro rp-note">SAFETY AND INTENT RUN CONCURRENTLY, INTENT IS CANCELLED WHEN SAFETY REJECTS</p>
            )}
          </>
        ))
      }
    </div>

    <div class="rp-footer">
      <KeyValue rows={COUNTS} dense keyWidth="auto" class="kv-inline" />
    </div>
  </Panel>

  <p class="text-small rp-footnote">{footnote}</p>
</div>
