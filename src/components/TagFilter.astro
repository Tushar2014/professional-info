---
interface Props {
  tags: string[]
  /** Noun used when the live count is 1. Matches the CountLine beside the grid. */
  singular?: string
  /** Noun used for every other count. */
  plural?: string
}

const { tags, singular = 'case study', plural = 'case studies' } = Astro.props

// A progressive enhancement over a list that is already complete. The full
// project list is server rendered and every card is visible; this control only
// ever adds the ability to narrow it.
//
// The attribute contract is fixed by tests/e2e/projects.spec.ts and must not be
// renamed: data-tag, data-tag="all", aria-pressed on every button, and the
// hidden attribute on [data-project] elements matched against data-tags.
---

<div
  class="tag-filter"
  role="group"
  aria-label="Filter case studies by tag"
  data-count-singular={singular}
  data-count-plural={plural}
>
  <p class="micro tag-filter-key" aria-hidden="true">FILTER</p>
  <button type="button" class="tag-btn" data-tag="all" aria-pressed="true">All</button>
  {
    tags.map((tag) => (
      <button type="button" class="tag-btn" data-tag={tag} aria-pressed="false">
        {tag}
      </button>
    ))
  }
</div>

<style>
  /*
    The control is not offered at all until JavaScript is running. .js is added
    to <html> by an inline head script before first paint, so there is no flash
    and no dead control is ever presented to a reader without scripting. The
    list it filters is rendered either way. This is the one legitimate use of
    .js: it gates a control, not a hidden pre-state.
  */
  .tag-filter {
    display: none;
  }

  :global(html.js) .tag-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .tag-filter-key {
    margin: 0 0.5rem 0 0;
  }

  .tag-btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-pill);
    font-weight: var(--text-pill--font-weight);
    line-height: var(--text-pill--line-height);
    letter-spacing: var(--text-pill--letter-spacing);
    padding: 7px 12px;
    background: transparent;
    border: 1px solid var(--color-edge-control);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color 140ms ease-out,
      background-color 140ms ease-out,
      border-color 140ms ease-out;
  }

  .tag-btn:hover,
  .tag-btn:focus-visible {
    color: var(--color-text);
    border-color: var(--color-text);
  }

  .tag-btn[aria-pressed='true'] {
    background: var(--color-raised);
    color: var(--color-text);
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>('.tag-filter')
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tag-filter [data-tag]'))
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project]'))
  const countLine = document.querySelector<HTMLElement>('.count-line')

  const singular = group?.dataset.countSingular ?? 'case study'
  const plural = group?.dataset.countPlural ?? 'case studies'

  /**
   * The element the grid lays out is the card's WRAPPER, not the card. Setting
   * hidden on the article alone left the wrapper in the grid, stretched to the
   * row height, as a 534px tall empty cell. Climbing exactly one level, and only
   * when the parent wraps this card alone, keeps the fix inside this component
   * and independent of whatever class the page gives that wrapper.
   */
  function gridItemOf(card: HTMLElement): HTMLElement {
    const parent = card.parentElement
    if (!(parent instanceof HTMLElement)) return card
    return parent.children.length === 1 ? parent : card
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const selected = button.dataset.tag ?? 'all'

      for (const other of buttons) {
        other.setAttribute('aria-pressed', String(other === button))
      }

      let shown = 0
      for (const card of cards) {
        const tags = (card.dataset.tags ?? '').split(' ').filter(Boolean)
        const hide = selected !== 'all' && !tags.includes(selected)
        // Both, and in this order. The card keeps the hidden attribute because
        // that is the tested contract; the wrapper needs it because that is what
        // occupies the grid cell.
        card.hidden = hide
        gridItemOf(card).hidden = hide
        if (!hide) shown += 1
      }

      // The count line is a statement about what is on screen, so it cannot go
      // on reading "5 case studies" while one card is visible.
      if (countLine) {
        countLine.textContent = `${shown} ${shown === 1 ? singular : plural}`
      }
    })
  }
</script>
